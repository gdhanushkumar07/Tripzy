# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# Leave VITE_FIREBASE_API_KEY empty to run fully locally against the Firebase emulators (npm run emulators).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Force emulators even when keys are set (true/false).
VITE_USE_EMULATORS=false

# Optional AI itinerary endpoint (POST answers JSON, returns a trip JSON).
# Leave empty: the app uses the built-in rule-based planner. Point it at a dead URL to demo the AI-failure path.
VITE_AI_PLANNER_URL=
