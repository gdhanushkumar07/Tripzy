# Copy to .env (never commit it). Every key is optional: without one, Tripzy uses a free no-key source.

# ---- Firebase web app (Firebase console → Project settings → Your apps → Web app)
# Leave VITE_FIREBASE_API_KEY empty to run fully locally on the Firebase emulators (npm run emulators).
# Enable Authentication → Sign-in method → Email/Password AND Google; create a Firestore database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Force emulators even when keys are set (true/false).
VITE_USE_EMULATORS=false

# ---- API server keys (read only by server/, never sent to the browser)
# Ola Maps — India geocoding, places, traffic-aware directions (100K free calls/month each): https://maps.olakrutrim.com
OLA_MAPS_API_KEY=
# Gemini — reads live web results to judge "is this a good day to visit?": https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Tavily — live web/news search for closures, festivals, crowds (1,000 free/month): https://tavily.com
TAVILY_API_KEY=
# OpenTripMap — popularity ratings for attractions: https://dev.opentripmap.org
OPENTRIPMAP_API_KEY=
# Indian Rail API — real trains between stations: https://indianrailapi.com
RAIL_API_KEY=
# ---- Journeys, flights and hotels (see docs/GLOBAL_JOURNEYS.md)
# SerpApi — live Google Flights + Google Hotels prices (250 free searches/month): https://serpapi.com/users/sign_up
SERPAPI_KEY=
# Travelpayouts — real recently-seen flight fares (Aviasales) + affiliate links: https://www.travelpayouts.com
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# LiteAPI — hotel rates (sandbox key = test prices, labelled): https://dashboard.liteapi.travel
LITEAPI_KEY=
# Geoapify — restaurants with diet tags/opening hours, hotel fallback, backup search (3,000/day): https://myprojects.geoapify.com
GEOAPIFY_API_KEY=
# Port for the API server (Vite proxies /api to it)
API_PORT=8787
