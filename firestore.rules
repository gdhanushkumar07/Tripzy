rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // User document and all nested private collections (trips, routes, chats, drafts, history)
    match /users/{uid} {
      allow read, write: if isUser(uid);

      match /{allChildren=**} {
        allow read, write: if isUser(uid);
      }
    }

    // Shared groups for collaborative trip and commute planning
    match /groups/{code} {
      allow read, write: if signedIn();
    }
  }
}
