{
  "name": "tripzy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"vite\" \"tsx watch server/index.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-tripzy",
    "build": "tsc -p . && tsc -p tsconfig.server.json && vite build && npm run build:api",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "web": "vite",
    "api": "tsx server/index.ts",
    "gtfs": "tsx scripts/gtfs-import.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.server.json",
    "airports": "tsx scripts/airports.ts",
    "scenarios": "tsx scripts/scenarios.ts",
    "build:api": "esbuild server/app.ts --bundle --platform=node --format=esm --target=node22 --outfile=server-dist/app.mjs --log-level=warning --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "firebase": "^13.3.0",
    "gsap": "^3.15.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "opening_hours": "^3.15.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
