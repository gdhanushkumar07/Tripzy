{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://tripzy-y6bi.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://tripzy-y6bi.onrender.com/uploads/$1"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "https://tripzy-y6bi.onrender.com/mcp/$1"
    },
    {
      "source": "/oauth/authorize",
      "destination": "https://tripzy-y6bi.onrender.com/oauth/authorize"
    },
    {
      "source": "/(.*)",
      "destination": "/client/dist/index.html"
    }
  ]
}
