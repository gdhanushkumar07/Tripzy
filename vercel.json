{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd platform && npm ci --no-audit --no-fund",
  "buildCommand": "cd platform && npm run build --workspace=shared && cd client && node scripts/generate-icons.mjs && npx vite build",
  "outputDirectory": "platform/client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND-HOST/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://YOUR-BACKEND-HOST/uploads/:path*" },
    { "source": "/mcp/:path*", "destination": "https://YOUR-BACKEND-HOST/mcp/:path*" },
    { "source": "/oauth/authorize", "destination": "https://YOUR-BACKEND-HOST/oauth/authorize" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
